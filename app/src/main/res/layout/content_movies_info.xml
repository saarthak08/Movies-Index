<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
        name="contentMovie"
        type="com.sg.moviesindex.data.local.Movie" />

    <variable
        name="checkBox"
        type="android.widget.CheckBox" />

    <variable
        name="locale"
        type="String" />
  </data>

  <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="?android:attr/colorBackground"
      app:layout_behavior="@string/appbar_scrolling_view_behavior"
      tools:context="com.sg.moviesindex.ui.details.MovieDetailActivity"
      tools:ignore="PrivateResource"
      tools:showIn="@layout/activity_movies_info">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/casts"
        app:layout_constraintTop_toBottomOf="@+id/casts">

      <TextView
          android:id="@+id/tvMovieTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:layout_marginEnd="104dp"
          android:fontFamily="@font/montserrat"
          android:padding="16dp"
          android:text="@{`Original Title:\n`+(contentMovie.title ?? ``)}"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          tools:layout_constraintStart_creator="1"
          tools:layout_constraintTop_creator="1" />

      <LinearLayout
          android:id="@+id/llMovieRating"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:layout_marginTop="8dp"
          android:layout_marginEnd="16dp"
          android:gravity="end"
          android:orientation="vertical"
          android:paddingTop="16dp"
          android:paddingBottom="4dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          tools:ignore="RtlSymmetry"
          tools:layout_constraintTop_creator="1">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/rating"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <antonkozyriatskyi.circularprogressindicator.CircularProgressIndicator
            android:id="@+id/circularProgress"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="start"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            app:direction="clockwise"
            app:dotColor="?colorPrimary"
            app:dotWidth="8dp"
            app:drawDot="true"
            app:enableProgressAnimation="true"
            app:fillBackground="false"
            app:formattingPattern="&#37;.1f"
            app:gradientEndColor="@color/colorAccent"
            app:gradientType="linear"
            app:progressBackgroundColor="?colorAccent"
            app:progressBackgroundStrokeWidth="4dp"
            app:progressCap="round"
            app:progressColor="?colorPrimary"
            app:progressStrokeWidth="8dp"
            app:startAngle="270"
            app:textColor="?android:attr/textColorPrimary"
            app:textSize="18sp" />

      </LinearLayout>


      <TextView
          android:id="@+id/tvStatus"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginEnd="104dp"
          android:fontFamily="@font/quicksand_medium"
          android:paddingStart="16dp"
          android:paddingTop="4dp"
          android:paddingEnd="16dp"
          android:paddingBottom="4dp"
          android:text="@{`Status: `+(contentMovie.status ?? ``)}"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvMovieTitle" />


      <TextView
          android:id="@+id/tvReleaseDate"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/quicksand_medium"
          android:paddingStart="16dp"
          android:paddingTop="4dp"
          android:paddingEnd="16dp"
          android:paddingBottom="4dp"
          android:text="@{`Release Date: `+(contentMovie.releaseDate ?? ``)}"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvStatus" />

      <TextView
          android:id="@+id/tvPopularity"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/quicksand_medium"
          android:paddingStart="16dp"
          android:paddingTop="4dp"
          android:paddingEnd="16dp"
          android:paddingBottom="4dp"
          android:text="@{`Runtime: `+(contentMovie.runtime/60)+`Hrs `+ (contentMovie.runtime%60) +`Mins`}"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvReleaseDate" />

      <TextView
          android:id="@+id/tvLanguage"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/quicksand_medium"
          android:paddingStart="16dp"
          android:paddingTop="4dp"
          android:paddingEnd="16dp"
          android:paddingBottom="4dp"
          android:text="@{`Original Language: `+ (locale ?? ``) }"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvPopularity" />

      <LinearLayout
          android:id="@+id/layoutMainActions"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvLanguage">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrailer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/open_sans"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="48dp"
            android:text="@string/watch_trailer"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="20dp"
            app:iconTint="@android:color/white" />

        <FrameLayout
            android:id="@+id/layoutDownloadContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1">

          <com.github.leandroborgesferreira.loadingbutton.customViews.CircularProgressButton
              android:id="@+id/btn_id"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:layout_gravity="center"
              android:background="@drawable/rounded_button_background"
              android:fontFamily="@font/open_sans"
              android:text="@string/download_torrent"
              android:textColor="@android:color/white"
              android:textSize="13sp"
              app:finalCornerAngle="24dp"
              app:initialCornerAngle="8dp"
              app:spinning_bar_color="@android:color/white"
              app:spinning_bar_padding="8dp"
              app:spinning_bar_width="3dp" />

        </FrameLayout>

      </LinearLayout>

      <LinearLayout
          android:id="@+id/layoutSecondaryActions"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/layoutMainActions">

        <com.varunest.sparkbutton.SparkButton
            android:id="@+id/spark_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:sparkbutton_activeImage="@drawable/ic_heart_on"
            app:sparkbutton_iconSize="36dp"
            app:sparkbutton_inActiveImage="@drawable/ic_heart_off"
            app:sparkbutton_primaryColor="@color/heart_primary_color"
            app:sparkbutton_secondaryColor="@color/heart_secondary_color" />

        <TextView
            android:id="@+id/tvFavoriteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/quicksand_medium"
            android:text="@string/favourite_movies"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchlist"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/add_to_watchlist"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="22dp"
            app:icon="@drawable/ic_bookmark_border"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="22dp"
            app:iconTint="?attr/colorPrimary"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/tvWatchlistLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/quicksand_medium"
            android:text="@string/watchlist"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

      </LinearLayout>

      <TextView
          android:id="@+id/tvOverview"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="@font/open_sans"
          android:paddingHorizontal="16dp"
          android:paddingTop="16dp"
          android:text="@string/overview"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/layoutSecondaryActions" />

      <TextView
          android:id="@+id/tvPlotsynopsis"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/roboto"
          android:paddingHorizontal="16dp"
          android:paddingBottom="16dp"
          android:text="@{contentMovie.overview}"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvOverview" />

      <TextView
          android:id="@+id/tvGenre"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="@font/open_sans"
          android:paddingHorizontal="16dp"
          android:paddingTop="16dp"
          android:text="@string/genre"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvPlotsynopsis" />

      <com.google.android.material.chip.ChipGroup
          android:id="@+id/chip_group"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:padding="2dp"
          android:paddingHorizontal="16dp"
          app:chipSpacingVertical="8dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvGenre" />

      <TextView
          android:id="@+id/tvWatchProvidersTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="@font/open_sans"
          android:paddingHorizontal="16dp"
          android:paddingTop="16dp"
          android:text="@string/where_to_watch"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/chip_group" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvWatchProviders"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:paddingHorizontal="16dp"
          android:paddingTop="8dp"
          android:paddingBottom="8dp"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvWatchProvidersTitle" />

      <LinearLayout
          android:id="@+id/castsLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp"
          android:paddingTop="8dp"
          app:layout_constraintBottom_toTopOf="@id/rvCasts"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/rvWatchProviders">

        <TextView
            android:id="@+id/casts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans"
            android:text="@string/casts"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

      </LinearLayout>


      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvCasts"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_marginBottom="16dp"
          android:paddingTop="8dp"
          android:paddingEnd="16dp"
          android:paddingBottom="16dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/castsLayout"
          tools:ignore="RtlSymmetry" />

      <TextView
          android:id="@+id/tvRecommendationsTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="@font/open_sans"
          android:paddingHorizontal="16dp"
          android:paddingTop="16dp"
          android:text="@string/recommendations"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/rvCasts" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvRecommendations"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_marginBottom="16dp"
          android:paddingTop="8dp"
          android:paddingEnd="16dp"
          android:paddingBottom="16dp"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/tvRecommendationsTitle"
          tools:ignore="RtlSymmetry" />

      <TextView
          android:id="@+id/reviews"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:fontFamily="@font/open_sans"
          android:paddingHorizontal="16dp"
          android:paddingTop="16dp"
          android:text="@string/reviews"
          android:textColor="?android:attr/textColorPrimary"
          android:textSize="20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/rvRecommendations" />

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvReviews"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="10dp"
          android:layout_marginBottom="40dp"
          android:paddingHorizontal="16dp"
          android:paddingBottom="16dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/reviews" />


    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.core.widget.NestedScrollView>
</layout>
