<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>

    <variable
        name="cast"
        type="com.sg.moviesindex.data.remote.Cast" />

  </data>

  <androidx.cardview.widget.CardView
      android:id="@+id/cvMovie"
      android:layout_width="140dp"
      android:layout_height="260dp"
      android:layout_margin="6dp"
      android:elevation="3dp"
      bind:cardBackgroundColor="?attr/colorSurface"
      bind:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

      <ImageView
          android:id="@+id/ivProfile"
          android:layout_width="match_parent"
          android:layout_height="175dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:scaleType="fitXY"
          bind:profileUrl="@{`https://image.tmdb.org/t/p/w500`+ cast.profilePath}"
          tools:ignore="contentDescription" />

      <TextView
          android:id="@+id/tvName"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/open_sans"
          android:lines="2"
          android:maxLines="2"
          android:paddingHorizontal="8dp"
          android:paddingTop="6dp"
          android:text="@{cast.name}"
          android:textColor="@color/colorPrimary"
          android:textSize="13sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/tvCharacter"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="@font/roboto"
          android:lines="1"
          android:maxLines="1"
          android:paddingHorizontal="8dp"
          android:paddingTop="2dp"
          android:paddingBottom="8dp"
          android:text="@{cast.character ?? ``}"
          android:textColor="?android:attr/textColorSecondary"
          android:textSize="12sp" />

    </LinearLayout>

  </androidx.cardview.widget.CardView>

</layout>
